<body><div class="wrap">
<header class="topbar"><div class="brand"><span class="logo" aria-hidden="true"><img src="data:image/jpeg;base64," alt="شعار اسمعني"></span><span>اسمعني</span></div><nav class="nav" aria-label="التنقل الرئيسي"><a href="#features">المميزات</a><a href="#chat-section">المحادثة</a><a href="#phrases">العبارات</a><a href="#dictionary">قاموس الإشارة</a><a href="#settings">الإعدادات</a><a href="#camera-sign">التعرّف بالكاميرا</a><a href="#sound-alert">كاشف الأصوات</a><a href="#emergency-card">بطاقة الطوارئ</a><a href="#lecture-notes">تدوين المحاضرات</a><a href="#access-directory">دليل الجهات</a><a href="#visual-reminder">المنبه المرئي</a></nav></header>
<main>
<section class="hero" id="home"><div><span class="eyebrow">تواصل للجميع</span><h1>تواصل أسهل..<br>لعالم أكثر شمولًا</h1><p>مساحة تساعد الصم وضعاف السمع على التواصل بطريقة أوضح، من خلال تحويل الكلام إلى نص، ونطق الرسائل، والعبارات السريعة.</p><div class="actions"><a href="#chat-section"><button>ابدأ المحادثة 💬</button></a><a href="#phrases"><button class="secondary">العبارات السريعة</button></a></div></div><div class="hero-art" aria-hidden="true"><div class="bubble"><img src="data:image/jpeg;base64," alt="شعار اسمعني"></div></div></section>
<section class="section" id="features"><div class="section-head"><h2>كيف يساعدك اسمعني؟</h2><p>أدوات بسيطة لتسهيل التواصل في المواقف اليومية.</p></div><div class="grid"><article class="card"><div class="feature-icon">🎙️</div><h3>الكلام إلى نص</h3><p>استخدمي الميكروفون لتحويل الكلام المسموع إلى كلمات مكتوبة، بحسب دعم المتصفح.</p></article><article class="card"><div class="feature-icon">🔊</div><h3>النص إلى صوت</h3><p>اجعلي الجهاز ينطق رسالتك بصوت مسموع ليسهل التواصل مع الطرف الآخر.</p></article><article class="card"><div class="feature-icon">🆘</div><h3>عبارات للطوارئ</h3><p>اعرضي عبارات واضحة بسرعة عند الحاجة إلى مساعدة أو توضيح أمر مهم.</p></article></div></section>
<section class="section" id="chat-section"><div class="section-head"><h2>💬 المحادثة</h2><p>اكتبي رسالة، أو استخدمي الميكروفون، أو اجعلي الموقع ينطق النص.</p></div><div class="panel"><div class="form-row"><div class="field"><label for="role">أنا أتحدث بصفتي</label><select id="role"><option value="deaf">الشخص الأصم / ضعيف السمع</option><option value="other">الشخص الآخر</option></select></div><div class="field"><label for="room">اسم المحادثة (اختياري)</label><input id="room" maxlength="40" placeholder="مثال: محادثتنا"></div><button id="reset">محادثة جديدة</button></div><p class="small">هذه نسخة تجريبية على الجهاز نفسه؛ لا ترسل رسائل إلى جهاز آخر.</p><div id="chat" class="chat" role="log" aria-live="polite" aria-label="رسائل المحادثة"></div><label for="message">اكتب رسالتك</label><textarea id="message" maxlength="1500" placeholder="اكتب هنا..."></textarea><div class="actions"><button id="send">إرسال الرسالة</button><button id="mic" class="secondary">🎙️ تحدث لتحويل الكلام إلى نص</button><button id="speak" class="secondary">🔊 انطق ردي</button><button id="copy" class="secondary">📋 نسخ المحادثة</button><button id="flipScreen" class="secondary" aria-pressed="false" title="عرض الرسائل مقلوبة للطرف المقابل">🔄 قلب الشاشة للطرف المقابل</button></div><div id="chatStatus" class="status" role="status" aria-live="polite"></div></div></section>
<section class="section" id="phrases"><div class="section-head"><h2><img class="inline-logo" src="data:image/jpeg;base64," alt="شعار اسمعني"> العبارات السريعة</h2><p>اختاري عبارة لتظهر في المحادثة أو اعرضيها أمام الشخص المقابل.</p></div><div class="panel"><div class="quick-cats" role="group" aria-label="فئات العبارات"><button class="secondary active" data-cat="daily">الحياة اليومية</button><button class="secondary" data-cat="school">المدرسة</button><button class="secondary" data-cat="health">الصحة</button><button class="secondary" data-cat="emergency">الطوارئ</button></div><div class="phrase-grid" id="phraseGrid"></div><div class="actions"><button id="showPhrase" class="secondary">عرض العبارة بحجم كبير</button><button id="sendPhrase">إضافة العبارة للمحادثة</button></div><div id="bigPhrase" class="panel hidden" style="text-align:center;font-size:clamp(1.6rem,5vw,2.7rem);font-weight:bold" aria-live="polite"></div></div></section>
<section class="section" id="simplify"><div class="section-head"><h2>✨ بسّط لي</h2><p>حوّلي الجملة الطويلة إلى صياغة أسهل للقراءة.</p></div><div class="panel"><label for="longText">الجملة التي تريد تبسيطها</label><textarea id="longText" placeholder="اكتبي جملة تحتاج إلى توضيح..."></textarea><div class="actions"><button id="simplifyBtn">تبسيط الجملة</button></div><label for="simpleText">الصياغة المبسطة</label><div id="simpleText" class="notice" aria-live="polite">ستظهر الصياغة هنا.</div><p class="small">في هذه النسخة، التبسيط تجريبي بقواعد بسيطة وليس متصلًا بخدمة ذكاء اصطناعي؛ يلزم ربط API آمن لتفعيل مساعد ذكي حقيقي.</p></div></section>
<section class="section" id="dictionary"><div class="section-head"><h2>🤟 قاموس إشارات مبسّط</h2><p>بطاقات تمهيدية لمفاهيم شائعة. الرموز هنا للتوضيح وليست رسومات معتمدة للغة الإشارة السعودية.</p></div><div class="dictionary-grid"><article class="sign-card"><div class="hand">👋</div><strong>مرحبًا</strong><p>التحية</p></article><article class="sign-card"><div class="hand">🙏</div><strong>شكرًا</strong><p>الامتنان</p></article><article class="sign-card"><div class="hand">🆘</div><strong>مساعدة</strong><p>طلب العون</p></article><article class="sign-card"><div class="hand">👍</div><strong>نعم / موافق</strong><p>الموافقة</p></article></div><p class="notice" style="margin-top:12px">للتعليم الصحيح، استبدلي الرموز لاحقًا بصور أو مقاطع موثوقة لإشارات معتمدة من مختصين بلغة الإشارة السعودية.</p></section>


<section class="section" id="camera-sign"><div class="section-head"><h2>📷 التعرّف على حركات اليد بالكاميرا</h2><p>استخدمي الكاميرا لالتقاط حركة اليد وعرض وصف تجريبي للحركة.</p></div><div class="panel"><div class="camera-layout" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:16px;align-items:start"><div><video id="signVideo" autoplay playsinline muted style="display:block;width:100%;aspect-ratio:4/3;object-fit:cover;background:#171526;border-radius:16px;border:1px solid var(--border)"></video><canvas id="signCanvas" class="hidden"></canvas><div class="actions"><button id="cameraStart">📷 تشغيل الكاميرا</button><button id="cameraStop" class="secondary">إيقاف الكاميرا</button></div></div><div><div id="signResult" class="notice" role="status" aria-live="polite">لم يتم تشغيل الكاميرا بعد.</div><p class="small">عند اكتشاف اليد، يعرض النموذج وصفًا أوليًا مثل «كف مفتوح» أو «قبضة». هذه ليست ترجمة معتمدة للغة الإشارة السعودية، ولا تفهم الكلمات أو الجمل بعد.</p><p class="small">تُحلّل الصورة داخل المتصفح ولا تُرفع إلى خادم. يلزم السماح باستخدام الكاميرا وفتح الموقع عبر HTTPS أو localhost.</p></div></div></div></section>
<section class="section" id="sound-alert"><div class="section-head"><h2>🔔 كاشف الأصوات والتنبيهات</h2><p>راقبي مستوى الصوت حولك واحصلي على تنبيه مرئي عند اكتشاف صوت مرتفع. هذه النسخة لا تميّز نوع الصوت بدقة.</p></div><div class="panel"><div class="actions"><button id="soundStart">▶️ تشغيل مراقبة الصوت</button><button class="secondary" id="soundStop">إيقاف</button></div><div id="soundMeter" class="notice" role="status" aria-live="polite">المراقبة متوقفة.</div><div style="height:16px;background:var(--border);border-radius:99px;overflow:hidden;margin-top:12px"><div id="soundLevel" style="height:100%;width:0;background:var(--accent);transition:width .15s"></div></div><p class="small">يتطلب إذن الميكروفون. تتم مراقبة مستوى الصوت محليًا داخل المتصفح ولا يتم إرسال الصوت إلى خادم.</p></div></section>
<section class="section" id="emergency-card"><div class="section-head"><h2>🆘 بطاقة الطوارئ الرقمية</h2><p>أنشئي بطاقة واضحة تساعد الآخرين على معرفة أفضل طريقة للتواصل معك.</p></div><div class="panel"><div class="form-row"><div class="field"><label for="emName">الاسم (اختياري)</label><input id="emName" maxlength="80" placeholder="الاسم"></div><div class="field"><label for="emContact">جهة اتصال للطوارئ (اختياري)</label><input id="emContact" maxlength="100" placeholder="اسم أو رقم جهة الاتصال"></div></div><div class="field"><label for="emNote">رسالة توضيحية</label><textarea id="emNote" rows="3">أنا من الصم أو ضعاف السمع. يرجى التواصل معي بالكتابة أو التحدث بوضوح ووجهي نحوي.</textarea></div><div class="actions"><button id="makeCard">إنشاء البطاقة</button><button class="secondary" id="printCard">طباعة / حفظ PDF</button></div><div id="emergencyPreview" class="card" style="margin-top:16px;border:2px solid var(--accent)"><h3>بطاقة تواصل للطوارئ</h3><p id="cardName">الاسم: —</p><p id="cardNote">أنا من الصم أو ضعاف السمع. يرجى التواصل معي بالكتابة أو التحدث بوضوح ووجهي نحوي.</p><p id="cardContact">جهة الاتصال: —</p></div><p class="small">لا تضيفي معلومات حساسة إلا إذا كنتِ مرتاحة لذلك؛ البيانات لا تُرسل إلى خادم.</p></div></section>
<section class="section" id="lecture-notes"><div class="section-head"><h2>📝 تدوين المحاضرات والاجتماعات</h2><p>حوّلي الكلام إلى نص أثناء المحاضرة إذا كان المتصفح يدعم التعرّف على الكلام.</p></div><div class="panel"><div class="actions"><button id="notesStart">🎙️ بدء التدوين</button><button class="secondary" id="notesStop">إيقاف التدوين</button><button class="secondary" id="notesCopy">نسخ النص</button><button class="secondary" id="notesDownload">تنزيل TXT</button></div><textarea id="lectureText" rows="7" placeholder="سيظهر النص هنا... ويمكنك أيضًا الكتابة يدويًا."></textarea><p id="notesStatus" class="small" role="status" aria-live="polite">جاهز. قد يتطلب التعرّف على الكلام اتصالًا بالإنترنت حسب المتصفح.</p></div></section>
<section class="section" id="access-directory"><div class="section-head"><h2>📍 دليل الجهات والخدمات</h2><p>اختصارات للبحث عن جهات يمكن التواصل معها؛ تحققي من توفر خدمات الصم مباشرة مع الجهة.</p></div><div class="panel"><div class="form-row"><div class="field"><label for="directoryType">نوع الجهة</label><select id="directoryType"><option value="مستشفيات تقدم خدمات لذوي الإعاقة السمعية">مستشفيات</option><option value="مراكز لغة الإشارة السعودية">مراكز لغة الإشارة</option><option value="خدمات ذوي الإعاقة السمعية في الجهات الحكومية">جهات حكومية</option><option value="مدارس وبرامج تعليم الصم وضعاف السمع">مدارس وبرامج تعليمية</option></select></div><div class="field"><label for="directoryCity">المدينة (اختياري)</label><input id="directoryCity" placeholder="مثال: جدة"></div></div><button id="directorySearch">🔎 البحث عن جهات</button><p class="small">يفتح البحث على الويب بدل عرض قائمة غير موثّقة داخل الموقع.</p></div></section>
<section class="section" id="visual-reminder"><div class="section-head"><h2>⏰ المنبه المرئي والاهتزازي</h2><p>أنشئي تذكيرًا يظهر على الشاشة، مع اهتزاز إذا كان الجهاز والمتصفح يدعمانه.</p></div><div class="panel"><div class="form-row"><div class="field"><label for="reminderText">نص التذكير</label><input id="reminderText" maxlength="160" placeholder="مثال: موعدي بعد خمس دقائق"></div><div class="field"><label for="reminderMinutes">بعد كم دقيقة؟</label><input id="reminderMinutes" type="number" min="1" max="1440" value="5"></div></div><div class="actions"><button id="reminderSet">ضبط التذكير</button><button class="secondary" id="reminderCancel">إلغاء التذكير</button></div><div id="reminderStatus" class="notice" role="status" aria-live="polite">لا يوجد تذكير مضبوط.</div></div></section>

<section class="section" id="settings"><div class="section-head"><h2>⚙️ إعدادات سهولة الوصول</h2><p>خصّصي العرض بما يناسبك.</p></div><div class="panel"><div class="settings"><button class="secondary" id="fontDown">A− تصغير الخط</button><button class="secondary" id="fontUp">A+ تكبير الخط</button><button class="secondary" id="contrast">◐ تباين عالٍ</button><button class="secondary" id="dark">🌙 الوضع الداكن</button><button class="secondary" id="resetSettings">إعادة الإعدادات</button></div><p class="small">يمكن استخدام الموقع بلوحة المفاتيح، والأزرار واضحة، والنصوص قابلة للتكبير.</p></div></section>
<section class="section"><div class="notice"><strong>ملاحظة الخصوصية:</strong> هذه نسخة تجريبية محلية ولا تحفظ الرسائل أو صور الكاميرا على خادم. لا تكتبي معلومات حساسة. التعرف على الكلام يحتاج إلى متصفح يدعمه وإذن الميكروفون واتصال آمن HTTPS.</div></section>
</main></div><footer>اسمعني — تواصل أسهل، لعالم أكثر شمولًا</footer>
<script>
const $=id=>document.getElementById(id);let messages=[],selectedPhrase='',role='deaf',activeRecognition=null,baseFont=16;
function status(s){$('chatStatus').textContent=s}
function render(){const box=$('chat');box.replaceChildren();messages.forEach(m=>{const item=document.createElement('div');item.className='msg'+(m.role===role?' mine':'');const who=document.createElement('div');who.className='who';who.textContent=m.role==='deaf'?'الشخص الأصم / ضعيف السمع':'الشخص الآخر';const text=document.createElement('div');text.textContent=m.text;item.append(who,text);box.append(item)});box.scrollTop=box.scrollHeight}
function sendText(t){t=(t||'').trim();if(!t)return;if(t.length>1500){status('الرسالة طويلة جدًا.');return}messages.push({role,text:t});render();status('تمت إضافة الرسالة إلى المعاينة.');}
$('role').onchange=e=>{role=e.target.value;render()};$('send').onclick=()=>{sendText($('message').value);$('message').value=''};$('message').addEventListener('keydown',e=>{if(e.key==='Enter'&&(e.ctrlKey||e.metaKey)){e.preventDefault();$('send').click()}});
$('reset').onclick=()=>{messages=[];render();$('message').value='';status('بدأت محادثة تجريبية جديدة.')};
let screenFlipped=false;$('flipScreen').onclick=()=>{screenFlipped=!screenFlipped;$('chat').classList.toggle('flipped',screenFlipped);$('flipScreen').setAttribute('aria-pressed',String(screenFlipped));$('flipScreen').textContent=screenFlipped?'↩️ إرجاع الشاشة للوضع الطبيعي':'🔄 قلب الشاشة للطرف المقابل';status(screenFlipped?'تم قلب عرض الرسائل ليقرأها الطرف المقابل.':'تمت إعادة عرض الرسائل للوضع الطبيعي.')};
$('speak').onclick=()=>{const t=$('message').value.trim()||messages.at(-1)?.text;if(!t){status('اكتبي رسالة أولًا أو أرسلي رسالة ليتم نطقها.');return}if(!('speechSynthesis'in window)){status('النطق غير مدعوم في هذا المتصفح.');return}speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang='ar-SA';u.rate=.9;u.onstart=()=>status('🔊 جاري نطق الرسالة…');u.onend=()=>status('انتهى نطق الرسالة.');speechSynthesis.speak(u)};
$('copy').onclick=async()=>{const t=messages.map(m=>(m.role==='deaf'?'الشخص الأصم / ضعيف السمع':'الشخص الآخر')+': '+m.text).join('\n');if(!t){status('لا توجد رسائل لنسخها.');return}try{await navigator.clipboard.writeText(t);status('تم نسخ المحادثة.')}catch{status('تعذر النسخ تلقائيًا؛ حددي نص الرسائل وانسخيه يدويًا.')}};
$('mic').onclick=()=>{if(activeRecognition){activeRecognition.stop();return}const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){status('التعرف على الكلام غير مدعوم في هذا المتصفح. جرّبي متصفحًا متوافقًا عبر HTTPS.');return}if(!window.isSecureContext){status('الميكروفون يحتاج إلى HTTPS أو localhost.');return}try{const rec=new SR();activeRecognition=rec;rec.lang='ar-SA';rec.continuous=false;rec.interimResults=true;rec.onstart=()=>{ $('mic').textContent='⏹️ إيقاف الاستماع';status('🎙️ جاري الاستماع… تحدثي الآن.');};rec.onresult=e=>{let t='';for(let i=0;i<e.results.length;i++)t+=e.results[i][0].transcript+' ';$('message').value=t.trim();};rec.onerror=e=>status('تعذر التعرف على الصوت. تحققي من إذن الميكروفون واتصال الإنترنت. ('+e.error+')');rec.onend=()=>{activeRecognition=null;$('mic').textContent='🎙️ تحدث لتحويل الكلام إلى نص';if($('message').value.trim())status('تم تحويل الكلام. راجعي النص ثم اضغطي إرسال الرسالة.')};rec.start()}catch(e){activeRecognition=null;status('تعذر تشغيل الميكروفون.')}};
const phrases={daily:[['👋','مرحبًا'],['🙏','شكرًا لك'],['💬','من فضلك اكتب لي'],['🔁','هل يمكنك إعادة الكلام؟'],['🐢','تحدث ببطء من فضلك'],['✅','فهمت، شكرًا']],school:[['📚','هل يمكنك إعادة الشرح؟'],['✍️','من فضلك اكتب المعلومة'],['❓','لدي سؤال'],['⏳','أحتاج وقتًا إضافيًا'],['👩‍🏫','أحتاج مساعدة المعلمة'],['📝','أين أجد الواجب؟']],health:[['🏥','أحتاج إلى طبيب'],['🤕','أشعر بالألم'],['💊','أحتاج إلى دواء'],['🚰','أحتاج إلى ماء'],['🧑‍⚕️','من فضلك اشرح لي ما سيحدث'],['📞','أريد التواصل مع أسرتي']],emergency:[['🆘','أحتاج مساعدة فورًا'],['🚑','أحتاج إلى إسعاف'],['⚠️','هناك خطر، انتبه!'],['📍','ساعدني في الوصول إلى هذا المكان'],['📱','اتصل بشخص أثق به'],['✋','لا أستطيع سماعك، من فضلك اكتب لي']]};
let activeCat='daily';function drawPhrases(){const grid=$('phraseGrid');grid.replaceChildren();phrases[activeCat].forEach(([icon,text])=>{const b=document.createElement('button');b.className='phrase'+(activeCat==='emergency'?' emergency':'');b.innerHTML='<span aria-hidden="true">'+icon+'</span><span>'+text+'</span>';b.onclick=()=>{selectedPhrase=text;$('bigPhrase').textContent=text;$('bigPhrase').classList.remove('hidden');status('تم اختيار العبارة: '+text)};grid.append(b)})}
document.querySelectorAll('[data-cat]').forEach(b=>b.onclick=()=>{activeCat=b.dataset.cat;document.querySelectorAll('[data-cat]').forEach(x=>x.classList.toggle('active',x===b));$('bigPhrase').classList.add('hidden');drawPhrases()});$('showPhrase').onclick=()=>{if(!selectedPhrase){status('اختاري عبارة أولًا.');return}$('bigPhrase').textContent=selectedPhrase;$('bigPhrase').classList.remove('hidden');$('bigPhrase').scrollIntoView({behavior:'smooth',block:'center'})};$('sendPhrase').onclick=()=>{if(!selectedPhrase){status('اختاري عبارة أولًا.');return}sendText(selectedPhrase);$('chat-section').scrollIntoView({behavior:'smooth'})};
$('simplifyBtn').onclick=()=>{const t=$('longText').value.trim();if(!t){$('simpleText').textContent='اكتبي جملة أولًا.';return}let s=t.replace(/يرجى|نرجو منكم|يرجى منكم/g,'من فضلك').replace(/استكمال الإجراءات المطلوبة/g,'إكمال المطلوب').replace(/الإدارة المختصة/g,'الإدارة المسؤولة').replace(/قبل انتهاء المدة المحددة/g,'قبل انتهاء الوقت المحدد').replace(/يتعين عليك/g,'يجب عليك').replace(/بناءً على ما سبق/g,'لذلك').replace(/في حال عدم/g,'إذا لم').replace(/يرجى العلم بأن/g,'اعلمي أن');$('simpleText').textContent=s;};
$('fontUp').onclick=()=>{baseFont=Math.min(22,baseFont+1);document.documentElement.style.fontSize=baseFont+'px'};$('fontDown').onclick=()=>{baseFont=Math.max(13,baseFont-1);document.documentElement.style.fontSize=baseFont+'px'};$('contrast').onclick=()=>document.body.classList.toggle('high-contrast');$('dark').onclick=()=>document.body.classList.toggle('dark');$('resetSettings').onclick=()=>{baseFont=16;document.documentElement.style.fontSize='16px';document.body.classList.remove('dark','high-contrast')};drawPhrases();


// التعرف التجريبي على وضعيات اليد عبر نموذج MediaPipe يعمل في المتصفح.
let signStream=null,handTask=null,handLoop=null,lastHandDetect=0;
$('cameraStart').onclick=async()=>{
 try{
  if(!navigator.mediaDevices?.getUserMedia)throw new Error('هذا المتصفح لا يتيح تشغيل الكاميرا.');
  if(!window.isSecureContext)throw new Error('يلزم فتح الموقع عبر HTTPS أو localhost لتشغيل الكاميرا.');
  $('signResult').textContent='جارٍ طلب إذن الكاميرا وتحميل نموذج التعرّف…';
  try{
   signStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'user'},width:{ideal:640},height:{ideal:480}},audio:false});
  }catch(cameraError){
   // بعض الأجهزة القديمة لا تدعم قيود الكاميرا الأمامية؛ نعيد المحاولة بإعداد أبسط.
   signStream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
  }
  const video=$('signVideo');video.setAttribute('playsinline','');video.muted=true;video.srcObject=signStream;await video.play();
  const vision=await import('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/+esm');
  const fileset=await vision.FilesetResolver.forVisionTasks('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm');
  handTask=await vision.HandLandmarker.createFromOptions(fileset,{baseOptions:{modelAssetPath:'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task',delegate:'CPU'},runningMode:'VIDEO',numHands:1});
  $('signResult').textContent='الكاميرا تعمل. ضعي يدك أمامها وجرّبي فتح الكف أو إغلاقه.';
  const detect=(now)=>{if(!signStream||!handTask)return;if(now-lastHandDetect>100){lastHandDetect=now;try{const result=handTask.detectForVideo(video,now);if(result.landmarks?.length){const pts=result.landmarks[0];let extended=0;[[8,6],[12,10],[16,14],[20,18]].forEach(([tip,pip])=>{if(pts[tip].y<pts[pip].y)extended++});let label=extended>=3?'🖐️ كف مفتوح — حركة تجريبية':extended===0?'✊ قبضة — حركة تجريبية':'✋ يد في وضعية متوسطة — حركة تجريبية';$('signResult').textContent=label+'\nتم اكتشاف يد أمام الكاميرا.';}else $('signResult').textContent='لم تُكتشف يد بوضوح. قرّبي يدك إلى الكاميرا وحسّني الإضاءة.';}catch(e){$('signResult').textContent='تعذّر تحليل الصورة؛ أعيدي تشغيل الكاميرا.'}}handLoop=requestAnimationFrame(detect)};handLoop=requestAnimationFrame(detect);
 }catch(e){stopSignCamera();let reason=e.message||'تحققي من الإذن والاتصال بالإنترنت.';if(e.name==='NotAllowedError'||e.name==='PermissionDeniedError')reason='تم رفض إذن الكاميرا. اسمحي للمتصفح باستخدام الكاميرا من إعدادات الموقع.';else if(e.name==='NotFoundError'||e.name==='DevicesNotFoundError')reason='لم يتم العثور على كاميرا متصلة بالجهاز.';else if(e.name==='NotReadableError'||e.name==='TrackStartError')reason='الكاميرا مستخدمة من تطبيق آخر. أغلقيه ثم حاولي مجددًا.';$('signResult').textContent='لم تعمل الكاميرا: '+reason;}
};
function stopSignCamera(){if(handLoop)cancelAnimationFrame(handLoop);handLoop=null;if(handTask){handTask.close();handTask=null}if(signStream)signStream.getTracks().forEach(t=>t.stop());signStream=null;$('signVideo').srcObject=null;$('signResult').textContent='تم إيقاف الكاميرا.'}
$('cameraStop').onclick=stopSignCamera;
window.addEventListener('pagehide',()=>{if(signStream)signStream.getTracks().forEach(t=>t.stop())});

// إضافات المشروع: كاشف مستوى الصوت، بطاقة الطوارئ، تدوين المحاضرات، دليل الجهات، والمنبه المرئي.
let soundCtx=null,soundStream=null,soundFrame=null,notesRecognition=null,reminderTimer=null;
$('soundStart').onclick=async()=>{try{if(!navigator.mediaDevices?.getUserMedia)throw Error('المتصفح لا يدعم الوصول إلى الميكروفون.');soundStream=await navigator.mediaDevices.getUserMedia({audio:true});soundCtx=new (window.AudioContext||window.webkitAudioContext)();const source=soundCtx.createMediaStreamSource(soundStream),analyser=soundCtx.createAnalyser();analyser.fftSize=512;source.connect(analyser);const data=new Uint8Array(analyser.fftSize);const tick=()=>{analyser.getByteTimeDomainData(data);let sum=0;for(const v of data){const n=(v-128)/128;sum+=n*n}const level=Math.min(100,Math.round(Math.sqrt(sum/data.length)*220));$('soundLevel').style.width=level+'%';if(level>24){$('soundMeter').textContent='⚠️ تم رصد صوت مرتفع حولك';$('soundMeter').style.borderColor='var(--accent)';if(navigator.vibrate)navigator.vibrate(100)}else $('soundMeter').textContent='👂 المراقبة تعمل — مستوى الصوت '+level+'٪';soundFrame=requestAnimationFrame(tick)};tick()}catch(e){$('soundMeter').textContent='تعذّر تشغيل الميكروفون: '+(e.message||'تحققي من الإذن وإعدادات المتصفح.')}};
function stopSound(){if(soundFrame)cancelAnimationFrame(soundFrame);if(soundStream)soundStream.getTracks().forEach(t=>t.stop());if(soundCtx)soundCtx.close();soundFrame=null;soundStream=null;soundCtx=null;$('soundLevel').style.width='0';$('soundMeter').textContent='المراقبة متوقفة.'} $('soundStop').onclick=stopSound;
function updateCard(){const name=$('emName').value.trim(),contact=$('emContact').value.trim(),note=$('emNote').value.trim();$('cardName').textContent='الاسم: '+(name||'—');$('cardContact').textContent='جهة الاتصال: '+(contact||'—');$('cardNote').textContent=note||'يرجى التواصل معي بالكتابة.'} $('makeCard').onclick=updateCard;$('printCard').onclick=()=>{updateCard();window.print()};
$('notesStart').onclick=()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){$('notesStatus').textContent='التعرّف على الكلام غير مدعوم في هذا المتصفح؛ يمكنك كتابة الملاحظات يدويًا.';return}try{notesRecognition=new SR();notesRecognition.lang='ar-SA';notesRecognition.continuous=true;notesRecognition.interimResults=true;notesRecognition.onresult=e=>{let finalText='';for(let i=e.resultIndex;i<e.results.length;i++)if(e.results[i].isFinal)finalText+=e.results[i][0].transcript+' ';if(finalText)$('lectureText').value+=finalText};notesRecognition.onerror=e=>$('notesStatus').textContent='تعذّر التعرّف على الكلام: '+e.error;notesRecognition.onend=()=>$('notesStatus').textContent='توقف التدوين.';notesRecognition.start();$('notesStatus').textContent='التدوين يعمل…';}catch(e){$('notesStatus').textContent='لم يتم بدء التدوين. جربي متصفحًا يدعم الميزة.'}};$('notesStop').onclick=()=>{if(notesRecognition)notesRecognition.stop();$('notesStatus').textContent='تم إيقاف التدوين.'};$('notesCopy').onclick=async()=>{try{await navigator.clipboard.writeText($('lectureText').value);$('notesStatus').textContent='تم نسخ النص.'}catch(e){$('lectureText').select();$('notesStatus').textContent='حددي النص وانسخيه يدويًا.'}};$('notesDownload').onclick=()=>{const blob=new Blob([$('lectureText').value],{type:'text/plain;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ملاحظات-المحاضرة.txt';a.click();URL.revokeObjectURL(a.href)};
$('directorySearch').onclick=()=>{const q=$('directoryType').value+' '+$('directoryCity').value.trim()+' السعودية';window.open('https://www.google.com/search?q='+encodeURIComponent(q),'_blank','noopener')};
$('reminderSet').onclick=()=>{const mins=Number($('reminderMinutes').value),msg=$('reminderText').value.trim()||'حان وقت التذكير';if(!Number.isFinite(mins)||mins<1||mins>1440){$('reminderStatus').textContent='اختاري مدة من دقيقة إلى 1440 دقيقة.';return}if(reminderTimer)clearTimeout(reminderTimer);$('reminderStatus').textContent='تم ضبط التذكير بعد '+mins+' دقيقة.';reminderTimer=setTimeout(()=>{const message='⏰ '+msg;$('reminderStatus').textContent=message;if(navigator.vibrate)navigator.vibrate([250,120,250]);if('Notification'in window&&Notification.permission==='granted')new Notification('اسمعني',{body:msg});alert(message)},mins*60000)};$('reminderCancel').onclick=()=>{if(reminderTimer)clearTimeout(reminderTimer);reminderTimer=null;$('reminderStatus').textContent='تم إلغاء التذكير.'};

</script></body></html>
