in-height:200px}.bubble{width:min(260px,100%);aspect-ratio:1;background:#fff;border:1px solid #ffffff60;border-radius:42% 58% 63% 37% / 40% 40% 60% 60%;display:grid;place-items:center;overflow:hidden;position:relative}.bubble img{width:100%;height:100%;object-fit:contain}.bubble:after{content:none}.eyebrow{display:inline-block;background:#ffffff24;padding:5px 12px;border-radius:30px;font-size:.9rem}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.section{padding:42px 0 8px;scroll-margin-top:20px}.section-head{margin-bottom:18px}.section-head h2{font-size:clamp(1.5rem,3vw,2.1rem);margin:0}.section-head p{color:var(--muted);margin:5px 0}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.card,.panel{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:20px;box-shadow:var(--shadow)}.feature-icon{font-size:2rem;background:var(--soft);display:grid;place-items:center;width:58px;height:58px;border-radius:17px}.card h3{margin:12px 0 5px}.card p{color:var(--muted);margin:0}.pill{display:inline-block;background:var(--green);color:#206d53;padding:4px 10px;border-radius:30px;font-size:.83rem}.panel{margin-top:16px}.panel h3{margin-top:0}.form-row{display:flex;gap:10px;flex-wrap:wrap;align-items:end}.field{flex:1;min-width:190px}label{display:block;font-weight:bold;margin:9px 0 5px}input,textarea,select{width:100%;padding:12px;border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--ink)}textarea{min-height:85px;resize:vertical}.chat{height:280px;overflow:auto;background:var(--bg);border:1px solid var(--border);border-radius:15px;padding:12px;transition:transform .2s}.chat.flipped{transform:rotate(180deg)}.chat.flipped .msg{transform:rotate(180deg)}.msg{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:10px 13px;margin:9px 0;max-width:90%;overflow-wrap:anywhere}.msg.mine{margin-right:auto;background:var(--soft)}.who{font-size:.8rem;color:var(--muted);margin-bottom:3px}.status{min-height:25px;color:var(--muted);font-size:.9rem;margin-top:8px}.small{font-size:.87rem;color:var(--muted)}.quick-cats{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.quick-cats button.active{outline:3px solid #b8a9f0}.phrase-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.phrase{min-height:78px;background:var(--surface);color:var(--ink);border:1px solid var(--border);text-align:right;display:flex;align-items:center;gap:10px}.phrase span{font-size:1.5rem}.phrase:hover{background:var(--soft)}.emergency{border-color:#f0b9c7}.emergency .phrase{border-color:#eab0bf}.dictionary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.sign-card{text-align:center;background:var(--surface);border:1px solid var(--border);padding:16px;border-radius:16px}.sign-card .hand{font-size:2.4rem}.sign-card p{margin:4px 0 0;color:var(--muted)}.settings{display:flex;gap:10px;flex-wrap:wrap}.settings button{flex:1;min-width:150px}.notice{background:var(--soft);padding:12px 15px;border-radius:14px;color:var(--muted)}.inline-logo{width:27px;height:27px;object-fit:contain;vertical-align:middle;border-radius:5px}footer{margin-top:48px;background:var(--surface);border-top:1px solid var(--border);padding:25px;text-align:center;color:var(--muted)}.hidden{display:none!important}.lang-en{direction:ltr;text-align:left}
